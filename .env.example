# Copie para .env e ajuste. NUNCA commite o .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portas no host (mude se já estiverem em uso por outro projeto) ----------
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- PostgreSQL ---------------------------------------------------------------
# Superusuário do container (usado apenas pelos scripts de init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financeiro
# app_owner: dono do schema, usado SOMENTE pelo Alembic
APP_OWNER_PASSWORD=owner_dev_password
# app_api: usado pela API e pelos workers (sujeito a RLS)
APP_API_PASSWORD=api_dev_password

DATABASE_URL=postgresql+asyncpg://app_api:api_dev_password@localhost:5432/financeiro
DATABASE_URL_OWNER=postgresql+asyncpg://app_owner:owner_dev_password@localhost:5432/financeiro

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Storage S3 (RustFS em dev, AWS S3 em produção) ------------------------------
S3_ENDPOINT_URL=http://localhost:9000
# Endereço do storage para o navegador (URLs pré-assinadas de upload/download)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey123
S3_REGION=us-east-1
S3_BUCKET_COMPROVANTES=comprovantes
S3_BUCKET_EXPORTS=exports

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Segredo de assinatura dos JWT (mín. 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres-no-minimo-0000
# Cookie de refresh com flag Secure. Navegadores aceitam Secure em http://localhost.
COOKIE_SECURE=true

# --- Web ----------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
